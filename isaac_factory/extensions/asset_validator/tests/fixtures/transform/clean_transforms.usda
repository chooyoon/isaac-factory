#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Three well-formed Xformables in an assembly hierarchy.
# Expected: validator emits zero issues.

def Xform "World"
{
    def Xform "Workbench"
    {
        double3 xformOp:translate = (0, 0, 0.5)
        double3 xformOp:scale     = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        def Cube "Bracket"
        {
            double size = 0.1
            double3 xformOp:translate = (0.2, 0, 0.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Cube "Box"
    {
        double size = 1
        double3 xformOp:translate = (1.5, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
