#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Box translate.z = 200 — exceeds the default floating heuristic (100 m).
# Expected: TRANSFORM.FLOATING_HEURISTIC (WARN) on /World/Box.

def Xform "World"
{
    def Cube "Box"
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 200)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
