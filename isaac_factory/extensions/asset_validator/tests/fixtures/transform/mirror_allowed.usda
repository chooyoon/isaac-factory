#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Negative scale on x — but `customData.mirror = true` waives the warning.
# Expected: zero issues (NON_POSITIVE_SCALE suppressed by the mirror metadata).

def Xform "World"
{
    def Cube "MirroredPart" (
        customData = { bool mirror = true }
    )
    {
        double size = 1
        double3 xformOp:scale = (-1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
