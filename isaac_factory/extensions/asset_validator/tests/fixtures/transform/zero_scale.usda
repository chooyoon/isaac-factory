#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Scale collapses x axis to 0 (< default min_scale_magnitude 1e-3).
# Expected: TRANSFORM.ZERO_SCALE (FAIL) on /World/Box.

def Xform "World"
{
    def Cube "Box"
    {
        double size = 1
        double3 xformOp:scale = (0, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
