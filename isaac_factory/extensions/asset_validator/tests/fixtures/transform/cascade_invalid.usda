#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Parent Xform has NaN in scale, child has clean transform.
# Expected:
#   - TRANSFORM.NAN_VALUE  (FAIL) on /World/Root          (parent)
#   - TRANSFORM.CASCADE_INVALID_WORLD (INFO) on /World/Root/Child  (descendant)

def Xform "World"
{
    def Xform "Root"
    {
        double3 xformOp:scale = (nan, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]

        def Cube "Child"
        {
            double size = 0.5
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
