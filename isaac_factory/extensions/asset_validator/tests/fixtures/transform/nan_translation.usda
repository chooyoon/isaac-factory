#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Translation has NaN on x axis.
# Expected: TRANSFORM.NAN_VALUE (FAIL) on /World/Box.

def Xform "World"
{
    def Cube "Box"
    {
        double size = 1
        double3 xformOp:translate = (nan, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
