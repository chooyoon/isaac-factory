#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Negative scale on x axis without `customData.mirror = true`.
# Expected: TRANSFORM.NON_POSITIVE_SCALE (WARN) on /World/Box.
# (would escalate to FAIL if the prim had a CollisionAPI)

def Xform "World"
{
    def Cube "Box"
    {
        double size = 1
        double3 xformOp:scale = (-1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
