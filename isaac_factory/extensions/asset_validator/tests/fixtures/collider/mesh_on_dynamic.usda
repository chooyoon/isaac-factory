#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# A single-triangle Mesh authored with PhysicsCollisionAPI +
# PhysicsRigidBodyAPI + UsdPhysics.MeshCollisionAPI(approximation="none").
# Dynamic body uses a non-convex mesh approximation, which the
# validator's `dynamic_allowed_approximations` excludes.
# Expected: COLLIDER.MESH_ON_DYNAMIC on /World/TriMesh.

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float    physics:gravityMagnitude = 0
    }

    def Mesh "TriMesh" (
        apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[]      faceVertexCounts  = [3]
        int[]      faceVertexIndices = [0, 1, 2]
        point3f[]  points            = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        token      physics:approximation = "none"

        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
