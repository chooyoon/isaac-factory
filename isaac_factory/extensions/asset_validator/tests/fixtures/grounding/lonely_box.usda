#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# 1m cube floating in empty space — no floor at all.
# Downward raycast finds nothing  →  GROUNDING.NO_SUPPORT_FOUND (FAIL).

def Xform "World"
{
    def Cube "Box" (
        customData = {
            dictionary asset_validator = {
                token grounded = "true"
            }
        }
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
