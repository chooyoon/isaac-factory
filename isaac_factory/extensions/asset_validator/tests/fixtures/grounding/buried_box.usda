#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# 1m cube translated to z=-0.5  →  AABB bottom z = -1.0  →
# gap = -1.0 - 0.0 = -1.0 m  →  GROUNDING.BURIED (FAIL).
# Penetrates the floor by 1 m.

def Xform "World"
{
    def Cube "Floor"
    {
        double size = 1
        double3 xformOp:scale = (10, 10, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Box" (
        customData = {
            dictionary asset_validator = {
                token grounded = "true"
            }
        }
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
